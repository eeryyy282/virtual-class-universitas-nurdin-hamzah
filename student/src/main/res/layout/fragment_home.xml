<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".presentation.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/image_view_logo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="9dp"
            android:layout_marginTop="17dp"
            android:contentDescription="@string/unh_logo_image_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logo_unh" />

        <TextView
            android:id="@+id/text_view_logo_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/lato"
            android:text="@string/unh_logo_title"
            android:textColor="@color/outline_color_theme"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/image_view_logo"
            app:layout_constraintStart_toEndOf="@+id/image_view_logo"
            app:layout_constraintTop_toTopOf="@+id/image_view_logo" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_view_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="54dp"
            android:backgroundTint="@color/classic_blue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image_view_logo"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Card.RightRounded">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image_view_user_profile"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="@string/user_profile_image_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profile_photo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircleImageView" />

                <TextView
                    android:id="@+id/text_view_user_id_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/student_id_title"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toEndOf="@+id/image_view_user_profile"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_view_user_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/id_text"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/text_view_user_id_title"
                    app:layout_constraintTop_toBottomOf="@+id/text_view_user_id_title" />

                <TextView
                    android:id="@+id/text_view_user_name_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/name_title"
                    android:textColor="@color/white"
                    app:layout_constraintBottom_toTopOf="@+id/text_view_user_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/text_view_user_id"
                    app:layout_constraintTop_toBottomOf="@+id/text_view_user_id" />

                <TextView
                    android:id="@+id/text_view_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/student_name_placeholder"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/text_view_user_name_title" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_view_academic_advisor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/blue_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_view_profile"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Card.RightBottomRounded">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp">

                <TextView
                    android:id="@+id/text_view_academic_advisor_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/academic_advisor_title"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_view_academic_advisor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/lecturer_name_placeholder"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/text_view_academic_advisor_title"
                    app:layout_constraintTop_toBottomOf="@+id/text_view_academic_advisor_title"
                    app:layout_constraintVertical_bias="0.0" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_view_assignment_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="24dp"
            android:backgroundTint="@color/background_color_card_view"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_view_academic_advisor">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/image_view_assignment_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/assignment_icon_description"
                    android:src="@drawable/assignment_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/outline_color_theme" />

                <TextView
                    android:id="@+id/text_view_assignment_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/assignment_section_title"
                    android:textColor="@color/outline_color_theme"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/image_view_assignment_icon"
                    app:layout_constraintEnd_toStartOf="@+id/image_button_detail_assignment"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toEndOf="@+id/image_view_assignment_icon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.461" />

                <TextView
                    android:id="@+id/text_view_assignment_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/assignment_section_description"
                    android:textColor="@color/text_color_themed"
                    app:layout_constraintEnd_toStartOf="@+id/image_button_detail_assignment"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/image_view_assignment_icon"
                    app:layout_constraintTop_toBottomOf="@+id/image_view_assignment_icon" />

                <ImageButton
                    android:id="@+id/image_button_detail_assignment"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/detail_assignment_button_description"
                    android:src="@drawable/arrow_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/text_view_assignment_description"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/image_view_assignment_icon"
                    app:tint="@color/outline_color_theme" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_assignment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_assignment_divider"
                    tools:listitem="@layout/item_assignment_home" />

                <View
                    android:id="@+id/view_assignment_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/outline_color_theme"
                    app:layout_constraintEnd_toEndOf="@+id/image_button_detail_assignment"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/image_view_assignment_icon"
                    app:layout_constraintTop_toBottomOf="@+id/text_view_assignment_description" />

                <ImageView
                    android:id="@+id/image_view_no_assignment"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/no_content_image_description"
                    android:src="@drawable/doesnt_have_an_content_icon"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="@+id/view_assignment_divider"
                    app:layout_constraintStart_toStartOf="@+id/view_assignment_divider"
                    app:layout_constraintTop_toBottomOf="@+id/view_assignment_divider" />

                <TextView
                    android:id="@+id/text_view_no_assignment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato"
                    android:text="@string/no_assignment_message"
                    android:textAlignment="center"
                    android:textColor="@color/text_color_themed"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/view_assignment_divider"
                    app:layout_constraintStart_toStartOf="@+id/view_assignment_divider"
                    app:layout_constraintTop_toBottomOf="@+id/image_view_no_assignment" />

                <ProgressBar
                    android:id="@+id/progress_bar_assignment"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="24dp"
                    android:indeterminateTint="@color/outline_color_theme"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/view_assignment_divider"
                    app:layout_constraintStart_toStartOf="@+id/view_assignment_divider"
                    app:layout_constraintTop_toBottomOf="@+id/view_assignment_divider" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/image_view_statistic_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/statistic_icon_description"
            android:src="@drawable/statistic_icon"
            app:layout_constraintStart_toStartOf="@+id/card_view_assignment_section"
            app:layout_constraintTop_toBottomOf="@+id/card_view_assignment_section"
            app:tint="@color/outline_color_theme" />

        <TextView
            android:id="@+id/text_view_statistic_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/lato"
            android:text="@string/statistics_title"
            android:textColor="@color/outline_color_theme"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/image_view_statistic_icon"
            app:layout_constraintStart_toEndOf="@+id/image_view_statistic_icon"
            app:layout_constraintTop_toTopOf="@+id/image_view_statistic_icon" />

        <TextView
            android:id="@+id/text_view_schedule_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/lato"
            android:text="@string/schedule_section_title"
            android:textColor="@color/outline_color_theme"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/image_view_schedule_icon"
            app:layout_constraintEnd_toEndOf="@+id/card_view_schedule"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/image_view_schedule_icon"
            app:layout_constraintTop_toTopOf="@+id/image_view_schedule_icon" />

        <ImageView
            android:id="@+id/image_view_schedule_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/schedule_icon_description"
            android:src="@drawable/schedule_icon"
            app:layout_constraintBottom_toBottomOf="@+id/image_view_statistic_icon"
            app:layout_constraintStart_toStartOf="@+id/card_view_schedule"
            app:layout_constraintTop_toTopOf="@+id/image_view_statistic_icon"
            app:layout_constraintVertical_bias="0.0"
            app:tint="@color/outline_color_theme" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_view_statistic"
            android:layout_width="120dp"
            android:layout_height="190dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/background_color_card_view"
            app:cardCornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/image_view_statistic_icon"
            app:layout_constraintTop_toBottomOf="@+id/image_view_statistic_icon">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <ProgressBar
                    android:id="@+id/progress_bar_statistic"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/outline_color_theme"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/image_view_no_statistic"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="14dp"
                    android:contentDescription="@string/no_content_image_description"
                    android:src="@drawable/doesnt_have_an_content_icon"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_view_no_statistic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato"
                    android:text="@string/failed_to_load_statistics"
                    android:textAlignment="center"
                    android:textColor="@color/text_color_themed"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/image_view_no_statistic"
                    app:layout_constraintVertical_bias="0.0" />

                <ImageView
                    android:id="@+id/image_view_statistic_fire_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="16dp"
                    android:contentDescription="@string/fire_icon_description"
                    android:src="@drawable/fire_icon"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/smoky_gray" />

                <TextView
                    android:id="@+id/text_view_statistic_streak_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/streak_count_placeholder"
                    android:textColor="@color/outline_color_theme"
                    android:textSize="24sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/image_view_statistic_fire_icon" />

                <TextView
                    android:id="@+id/text_view_statistic_streak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/streak_label"
                    android:textAlignment="center"
                    android:textColor="@color/text_color_themed"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_view_statistic_streak_count"
                    app:layout_constraintVertical_bias="0.0" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_view_schedule"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:backgroundTint="@color/background_color_card_view"
            app:cardCornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/card_view_statistic"
            app:layout_constraintEnd_toEndOf="@+id/card_view_assignment_section"
            app:layout_constraintStart_toEndOf="@+id/card_view_statistic"
            app:layout_constraintTop_toTopOf="@+id/card_view_statistic">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <ProgressBar
                    android:id="@+id/progress_bar_schedule"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/outline_color_theme"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/image_view_no_schedule"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/no_content_image_description"
                    android:src="@drawable/doesnt_have_an_content_icon"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_view_no_schedule"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/no_schedule_message"
                    android:textAlignment="center"
                    android:textColor="@color/text_color_themed"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/image_view_no_schedule"
                    app:layout_constraintVertical_bias="0.0" />

                <TextView
                    android:id="@+id/text_view_schedule_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="14dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/schedule_time_placeholder"
                    android:textColor="@color/outline_color_theme"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_view_schedule_classroom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="14dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/classroom_label"
                    android:textColor="@color/outline_color_theme"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/text_view_schedule_time"
                    app:layout_constraintTop_toBottomOf="@+id/text_view_schedule_time" />

                <TextView
                    android:id="@+id/text_view_schedule_subject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="14dp"
                    android:fontFamily="@font/lato"
                    android:text="@string/subject_name_placeholder"
                    android:textColor="@color/text_color_themed"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/text_view_schedule_time"
                    app:layout_constraintTop_toBottomOf="@+id/text_view_schedule_classroom" />

                <Button
                    android:id="@+id/button_schedule_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:backgroundTint="@color/air_force_blue"
                    android:fontFamily="@font/lato"
                    android:text="@string/see_details_button"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    app:cornerRadius="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/text_view_schedule_subject"
                    app:layout_constraintStart_toStartOf="@+id/text_view_schedule_subject"
                    app:layout_constraintTop_toBottomOf="@+id/text_view_schedule_subject"
