<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.schedule.ScheduleFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/image_view_logo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="9dp"
            android:layout_marginTop="17dp"
            android:contentDescription="@string/unh_logo_image_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logo_unh" />

        <TextView
            android:id="@+id/text_view_logo_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/lato"
            android:text="@string/unh_logo_title"
            android:textColor="@color/outline_color_theme"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/image_view_logo"
            app:layout_constraintStart_toEndOf="@+id/image_view_logo"
            app:layout_constraintTop_toTopOf="@+id/image_view_logo" />

        <ImageView
            android:id="@+id/image_view_schedule_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="18dp"
            android:contentDescription="@string/schedule_icon_description"
            android:src="@drawable/schedule_icon"
            app:layout_constraintStart_toStartOf="@+id/image_view_logo"
            app:layout_constraintTop_toBottomOf="@+id/image_view_logo"
            app:tint="@color/outline_color_theme" />

        <TextView
            android:id="@+id/text_view_schedule_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/lato"
            android:text="@string/schedule_title"
            android:textColor="@color/outline_color_theme"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/image_view_schedule_icon"
            app:layout_constraintStart_toEndOf="@+id/image_view_schedule_icon"
            app:layout_constraintTop_toTopOf="@+id/image_view_schedule_icon" />

        <TextView
            android:id="@+id/text_view_schedule_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="27dp"
            android:fontFamily="@font/lato"
            android:text="@string/schedule_page_description"
            android:textColor="@color/text_color_themed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/image_view_schedule_icon"
            app:layout_constraintTop_toBottomOf="@+id/image_view_schedule_icon" />

        <ProgressBar
            android:id="@+id/progress_bar_schedule_loading"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="128dp"
            android:indeterminateTint="@color/outline_color_theme"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/text_view_schedule_description"
            app:layout_constraintStart_toStartOf="@+id/text_view_schedule_description"
            app:layout_constraintTop_toBottomOf="@+id/text_view_schedule_description" />

        <ImageView
            android:id="@+id/image_view_no_schedule"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="84dp"
            android:contentDescription="@string/no_schedule_image_description"
            android:src="@drawable/doesnt_have_an_content_icon"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/text_view_schedule_description"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="@+id/text_view_schedule_description"
            app:layout_constraintTop_toBottomOf="@id/text_view_schedule_description" />

        <TextView
            android:id="@+id/text_view_no_schedule_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/lato"
            android:text="@string/no_schedule_message"
            android:textAlignment="center"
            android:textColor="@color/text_color_themed"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/text_view_schedule_description"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/text_view_schedule_description"
            app:layout_constraintTop_toBottomOf="@+id/image_view_no_schedule"
            app:layout_constraintVertical_bias="0.0" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_schedule_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/text_view_schedule_description"
            app:layout_constraintStart_toStartOf="@+id/text_view_schedule_description"
            app:layout_constraintTop_toBottomOf="@+id/text_view_schedule_description"
            tools:listitem="@layout/item_schedule" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
